{
  "expo": {
    "name": "Ví Của Tôi",
    "slug": "multi-wallet-management",
    "scheme": "com.thang.multiwallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thang.multiwallet"
    },
    "android": {
      "package": "com.thang.multiwallet",
      "adaptiveIcon": {
        "backgroundColor": "#EFEFE5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F5"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-local-authentication",
      "expo-web-browser",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WalletWidget",
              "label": "Ví Của Tôi - Số Dư & Thu Chi",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "380dp",
              "maxResizeHeight": "180dp",
              "resizeMode": "horizontal|vertical",
              "description": "Xem số dư, thu chi tháng và tạo nhanh giao dịch (+/-)",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dae2ff64-6e2a-4073-af2f-705684443c36"
      }
    }
  }
}
